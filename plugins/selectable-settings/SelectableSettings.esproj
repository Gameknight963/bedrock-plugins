<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <Target Name="DeclarePluginFiles" BeforeTargets="PackagePlugin">
    <ItemGroup>
      <PluginFile Include="plugin.json"><PackagePath>plugin.json</PackagePath></PluginFile>
      <PluginFile Include="README.md"><PackagePath>README.md</PackagePath></PluginFile>
      <PluginFile Include="LICENSE"><PackagePath>LICENSE</PackagePath></PluginFile>
      <PluginFile Include="renderer.js"><PackagePath>renderer.js</PackagePath></PluginFile>
    </ItemGroup>
  </Target>
  <Import Project="..\..\tools\Plugin.targets" />
</Project>
