<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{D8312270-05D3-4BE3-B4E9-70D39F4CC127}</ProjectGuid>
    <RootNamespace>WindowCustomization</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup><BedrockSdkRoot Condition="'$(BedrockSdkRoot)'==''">$(ProjectDir)..\..\.sdk\bedrock</BedrockSdkRoot></PropertyGroup>
  <PropertyGroup>
    <TargetName>window</TargetName>
    <TargetExt>.node</TargetExt>
    <OutDir>$(ProjectDir)src\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)src\obj\$(Platform)\$(Configuration)\</IntDir>
    <NodeLibraryMachine Condition="'$(Platform)'=='x64'">X64</NodeLibraryMachine>
    <NodeLibraryMachine Condition="'$(Platform)'=='Win32'">X86</NodeLibraryMachine>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(BedrockSdkRoot)\lib\node-api;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>BUILDING_NODE_EXTENSION;NAPI_VERSION=8;UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(IntDir)node.lib;delayimp.lib;user32.lib;comctl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>node.exe;%(DelayLoadDLLs)</DelayLoadDLLs>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="src\exports.c" /><ClCompile Include="src\window.c" /><ClCompile Include="src\delay-load.c" /></ItemGroup>
  <ItemGroup><ClInclude Include="src\window.h" /></ItemGroup>
  <ItemGroup>
    <CustomBuild Include="src\node.def">
      <Command>lib.exe /nologo /def:"%(FullPath)" /machine:$(NodeLibraryMachine) /out:"$(IntDir)node.lib"</Command>
      <Outputs>$(IntDir)node.lib</Outputs>
      <Message>Generating the Node-API import library</Message>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <None Include="LICENSE" />
    <None Include="main.js" />
    <None Include="renderer.js" />
    <None Include="package.json" />
    <None Include="plugin.json" />
    <None Include="README.md" />
    <None Include="Titlebar-For-Everyone-LICENSE.txt" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="DeclarePluginFiles" BeforeTargets="PackagePlugin">
    <ItemGroup>
      <PluginFile Include="plugin.json"><PackagePath>plugin.json</PackagePath></PluginFile>
      <PluginFile Include="README.md"><PackagePath>README.md</PackagePath></PluginFile>
      <PluginFile Include="LICENSE"><PackagePath>LICENSE</PackagePath></PluginFile>
      <PluginFile Include="main.js"><PackagePath>main.js</PackagePath></PluginFile>
      <PluginFile Include="renderer.js"><PackagePath>renderer.js</PackagePath></PluginFile>
      <PluginFile Include="$(TargetPath)"><PackagePath>native\win32-x64\window.node</PackagePath></PluginFile>
      <PluginFile Include="Titlebar-For-Everyone-LICENSE.txt"><PackagePath>native\win32-x64\Titlebar-For-Everyone-LICENSE.txt</PackagePath></PluginFile>
      <PluginFile Include="package.json"><PackagePath>package.json</PackagePath></PluginFile>
      <PluginFile Include="$(BedrockSdkRoot)\lib\node-api\LICENSE"><PackagePath>native\win32-x64\Node-API-LICENSE.txt</PackagePath></PluginFile>
    </ItemGroup>
  </Target>
  <Import Project="..\..\tools\Plugin.targets" />
</Project>
