{
    "manifestVersion": 3,
    "id": "gameknight963.native-menus",
    "name": "Native Menus",
    "version": "1.0.4",
    "description": "Render Discord menus with WinForms and optional background blur.",
    "entrypoints": {
        "main": {
            "runtime": "dotnet",
            "path": "NativeMenus.dll"
        },
        "renderer": {
            "runtime": "javascript",
            "path": "renderer.js",
            "requiresApi": "1.1.0"
        }
    },
    "readme": "README.md",
    "license": "MIT"
}
